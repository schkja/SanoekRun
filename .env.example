# Build-time defaults. Copy to `.env` (or set in the build environment) and
# change any line. Players can still override these in the in-game Settings.

# Turn every effect off at once (handy for debugging):
# VITE_FX=off

# Individual effects (true/false):
VITE_FX_COIN_SPARKLE=true
VITE_FX_SPEED_LINES=true
VITE_FX_SLOW_MOTION=true
VITE_FX_TURN_TILT=true
VITE_FX_CAMERA_SHAKE=true
VITE_FX_SCREEN_FLASH=true
VITE_FX_SPEED_ZOOM=true
VITE_FX_OUTLINES=true

# auto (follows the phone), en, de, ru, uk or es
VITE_LANGUAGE=auto

# lumberjack or squirrel
VITE_CHARACTER=lumberjack

# chase, hop, menu or off
VITE_MUSIC=chase

VITE_SOUND=true

# The link printed on share cards.
VITE_SHARE_URL=https://sanoekrun.sascha.iodatalabs.dev
